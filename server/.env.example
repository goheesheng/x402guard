# Server
# Port 3001 for internal API server (Next.js runs on 3000)
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# x402 Configuration
X402_PAY_TO_ADDRESS=0xYourWalletAddress
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Coinbase CDP API Credentials (optional - for authenticated facilitator)
# Get these from: https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Pricing (in USDC atomic units - 6 decimals)
# $0.01 = 10000, $0.05 = 50000, $0.10 = 100000
PRICE_QUICK=10000
PRICE_STANDARD=50000
PRICE_DEEP=100000

# Limits
MAX_SKILL_SIZE=1048576
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
