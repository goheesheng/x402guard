# Base service config
BASE_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# x402 payment config
X402_PAY_TO_ADDRESS=0xYourPaymentAddress
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# X402_NETWORK is forced to Base mainnet by server config

# Optional Coinbase CDP credentials (recommended in production)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional x402scan ownership proof
OWNERSHIP_PROOF_PRIVATE_KEY=
OWNERSHIP_PROOF_SIGNATURE=

# Deep attestation signing (required for paid deep tier)
ATTESTATION_PRIVATE_KEY=
# Optional trusted signer used by /api/verify (defaults to X402_PAY_TO_ADDRESS)
ATTESTATION_TRUSTED_SIGNER=

# Pricing in USDC atomic units (6 decimals)
PRICE_QUICK=10000
PRICE_STANDARD=50000
PRICE_DEEP=100000

# Limits and security controls
MAX_SKILL_SIZE=1048576
FETCH_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=0
