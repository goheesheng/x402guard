{
  "name": "skillguard",
  "version": "1.0.0",
  "private": true,
  "description": "SkillGuard - x402-powered security auditing for AI agent skills",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "dev:web": "pnpm --filter @skillguard/web dev",
    "dev:api": "pnpm --filter @skillguard/api dev",
    "build:web": "pnpm --filter @skillguard/web build",
    "build:api": "pnpm --filter @skillguard/api build"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
