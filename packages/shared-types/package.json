{
  "name": "@x402guard/shared-types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for x402guard packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
